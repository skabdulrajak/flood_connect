# =============================================================================
# FloodConnect Environment Configuration Template
# Copy to `.env.local` for local development. Never commit real secrets.
# SECURITY: NEVER put a Supabase `service_role` key in any `VITE_*` variable.
# =============================================================================

# Mode Switch:
#   "true"  -> Simulated East Godavari demo layer (localStorage/in-memory)
#   "false" -> Real Supabase backend (requires VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY)
VITE_DEMO_MODE="true"

# Supabase Project Credentials (Public Anon Key ONLY; protected by PostgreSQL RLS)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Gemini AI Configuration (called ONLY via src/services/aiService.js)
# Leave blank to transparently fall back to deterministic rules with the notice:
# "AI unavailable, using basic rules".
# PRODUCTION NOTE: Move Gemini calls to the FastAPI backend proxy (see docs/FUTURE_BACKEND.md)
# and leave VITE_GEMINI_API_KEY empty in production browser builds.
VITE_GEMINI_API_KEY=""

# Optional Future Python FastAPI AI Proxy Base URL (e.g. https://floodconnect-ai.onrender.com)
# Setting this single variable routes /classify, /duplicates, /priority, /translate,
# and /summarize-area through the backend proxy instead of calling Gemini directly.
VITE_AI_BACKEND_URL=""

# Optional (NOT CONNECTED): Future Firebase Cloud Messaging (FCM) Web Push stub
# Used only by src/services/notificationService.js when a push relay is added later.
VITE_FCM_VAPID_KEY=""
VITE_PUSH_RELAY_URL=""
